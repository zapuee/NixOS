// Generated by theme-manager. Do not edit manually.
// Active structure profile: paper

layout {
    gaps 6
    struts {
        left 2
        right 2
        top 2
        bottom 2
    }
    focus-ring {
        on
        width 2
        active-color "rgba(128, 217, 152, 1.0)"
        inactive-color "rgba(124, 149, 152, 0.7)"
        urgent-color "rgba(255, 180, 171, 1.0)"
    }
    shadow {
        on
        color "rgba(0, 0, 0, 0.15)"
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id="^firefox$"
    geometry-corner-radius 0
    clip-to-geometry true
    opacity 1.0
}

window-rule {
    match app-id="^(foot|footclient)$"
    geometry-corner-radius 0
    clip-to-geometry true
}
