// Generated by theme-manager. Do not edit manually.
// Active structure profile: glass

layout {
    gaps 8
    struts {
        left 4
        right 4
        top 4
        bottom 4
    }
    focus-ring {
        on
        width 2
        active-color "rgba(128, 217, 152, 0.4)"
        inactive-color "rgba(124, 149, 152, 0.25)"
        urgent-color "rgba(255, 180, 171, 0.25)"
    }
    shadow {
        on
        color "rgba(0, 0, 0, 1.0)"
    }
}

window-rule {
    geometry-corner-radius 1
    clip-to-geometry true
}

window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id="^firefox$"
    geometry-corner-radius 1
    clip-to-geometry true
    opacity 0.85
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="^(foot|footclient)$"
    geometry-corner-radius 1
    clip-to-geometry true
    background-effect {
        blur true
    }
}
