--!strict

local GENERATED_MARKER = "Generated by theme-manager. Do not edit manually."

local function number(value)
    if value % 1 == 0 then
        return string.format("%.0f", value)
    end
    return tostring(value)
end

local function float(value)
    local rendered = tostring(value)
    if not string.find(rendered, "[%.eE]") then
        return rendered .. ".0"
    end
    return rendered
end

local function escape_kdl(value)
    return string.gsub(string.gsub(value, "\\", "\\\\"), '"', '\\"')
end

local function rgba(color, opacity)
    local hex = string.gsub(color, "^#", "")
    if (#hex ~= 6 and #hex ~= 8) or not string.match(hex, "^%x+$") then
        error("niri target expected a hex color, got '" .. tostring(color) .. "'")
    end

    local red = tonumber(string.sub(hex, 1, 2), 16)
    local green = tonumber(string.sub(hex, 3, 4), 16)
    local blue = tonumber(string.sub(hex, 5, 6), 16)
    local source_alpha = 1
    if #hex == 8 then
        source_alpha = tonumber(string.sub(hex, 7, 8), 16) / 255
    end
    local alpha = math.clamp(source_alpha * opacity, 0, 1)
    return "rgba(" .. red .. ", " .. green .. ", " .. blue .. ", " .. float(alpha) .. ")"
end

local function append_role_rule(lines, app_id, role, use_opacity)
    if string.find(app_id, "%c") then
        error("niri app-id match may not contain control characters")
    end

    table.insert(lines, "window-rule {")
    table.insert(lines, "    match app-id=\"" .. escape_kdl(app_id) .. "\"")
    if role.corner_radius ~= nil then
        table.insert(lines, "    geometry-corner-radius " .. number(role.corner_radius))
        table.insert(lines, "    clip-to-geometry true")
    end
    if use_opacity and role.background_opacity ~= nil then
        table.insert(lines, "    opacity " .. float(role.background_opacity))
    end
    if role.blur == true then
        table.insert(lines, "    background-effect {")
        table.insert(lines, "        blur true")
        table.insert(lines, "    }")
    end
    table.insert(lines, "}")
    table.insert(lines, "")
end

return {
    render = function(ctx)
        local theme = ctx.theme
        local settings = ctx.settings
        local global_role = settings.global_role or "compositor"
        local lines = {
            "// " .. GENERATED_MARKER,
            "// Active structure profile: " .. theme.profile,
            "",
            "layout {",
            "    gaps " .. number(theme.layout.gaps),
        }

        local strut = theme.layout.outer_gaps - theme.layout.gaps
        table.insert(lines, "    struts {")
        table.insert(lines, "        left " .. number(strut))
        table.insert(lines, "        right " .. number(strut))
        table.insert(lines, "        top " .. number(strut))
        table.insert(lines, "        bottom " .. number(strut))
        table.insert(lines, "    }")
        table.insert(lines, "    focus-ring {")
        table.insert(lines, "        on")
        table.insert(lines, "        width " .. number(theme.focus_ring.width))
        table.insert(lines, "        active-color \"" .. rgba(theme.focus_ring.active_color, theme.focus_ring.active_opacity) .. "\"")
        table.insert(lines, "        inactive-color \"" .. rgba(theme.focus_ring.inactive_color, theme.focus_ring.inactive_opacity) .. "\"")
        table.insert(lines, "        urgent-color \"" .. rgba(theme.focus_ring.urgent_color, theme.focus_ring.urgent_opacity) .. "\"")
        table.insert(lines, "    }")
        table.insert(lines, "    shadow {")
        table.insert(lines, "        on")
        table.insert(lines, "        color \"" .. rgba(theme.shadow.color, theme.shadow.strength) .. "\"")
        table.insert(lines, "    }")
        table.insert(lines, "}")
        table.insert(lines, "")

        local global = theme.roles[global_role]
        if global ~= nil and global.corner_radius ~= nil then
            table.insert(lines, "window-rule {")
            table.insert(lines, "    geometry-corner-radius " .. number(global.corner_radius))
            table.insert(lines, "    clip-to-geometry true")
            table.insert(lines, "}")
            table.insert(lines, "")
        end

        table.insert(lines, "window-rule {")
        table.insert(lines, "    draw-border-with-background false")
        table.insert(lines, "}")
        table.insert(lines, "")

        for _, binding in ipairs(settings.windows or {}) do
            local role = theme.roles[binding.role]
            if role == nil then
                error("niri window binding references missing role '" .. tostring(binding.role) .. "'")
            end
            local use_opacity = binding.use_opacity
            if use_opacity == nil then
                use_opacity = true
            end
            append_role_rule(lines, binding.app_id, role, use_opacity)
        end

        return { config = table.concat(lines, "\n") .. "\n" }
    end,
}
