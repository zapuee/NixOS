--!strict

local GENERATED_MARKER = "Generated by theme-manager. Do not edit manually."

return {
    render = function(ctx)
        local role_name = ctx.settings.role or "terminal"
        local role = ctx.theme.roles[role_name]
        if type(role) ~= "table" then
            error("foot target references missing role '" .. tostring(role_name) .. "'")
        end

        local opacity = role.background_opacity
        if type(opacity) ~= "number" then
            error("role '" .. tostring(role_name) .. "' has no background_opacity")
        end
        if opacity < 0 or opacity > 1 then
            error("foot background opacity must be between 0 and 1")
        end

        local alpha = tostring(opacity)
        return {
            config = "# " .. GENERATED_MARKER
                .. "\n# Active structure profile: " .. ctx.theme.profile
                .. "\n\n[colors-dark]\nalpha=" .. alpha
                .. "\n\n[colors-light]\nalpha=" .. alpha .. "\n",
        }
    end,
}
