--!nonstrict

local resolver = require("../resolver.luau")

local generator = {}

local function resolveOpacity(
    variables,
    niri,
    variableName,
    propertyName
)
    local value, err =
        resolver.default(
            variables,
            variableName,
            niri[variableName],
            propertyName
        )

    if err ~= nil then
        return nil, err
    end

    return resolver.number(
        value,
        propertyName,
        0,
        1
    )
end

function generator.generate(profile)
    local variables = profile.variables or {}
    local applications = profile.applications or {}
    local niri = applications.niri or {}

    local lines = {
        "// Generated by zap/theme-manager",
        "// Rendered by Noctalia using the current wallpaper palette.",
        "",
    }

    if niri.enabled == false then
        table.insert(lines, "// Niri theming disabled.")
        table.insert(lines, "")
        return table.concat(lines, "\n"), nil
    end

    local activeColor, err =
        resolver.colorRole(
            niri.focus_ring_active_color,
            "Niri active focus ring color"
        )

    if err ~= nil then
        return nil, err
    end

    local inactiveColor
    inactiveColor, err =
        resolver.colorRole(
            niri.focus_ring_inactive_color,
            "Niri inactive focus ring color"
        )

    if err ~= nil then
        return nil, err
    end

    local urgentColor
    urgentColor, err =
        resolver.colorRole(
            niri.focus_ring_urgent_color,
            "Niri urgent focus ring color"
        )

    if err ~= nil then
        return nil, err
    end

    local activeOpacity
    activeOpacity, err =
        resolveOpacity(
            variables,
            niri,
            "focus_ring_active_opacity",
            "Niri active focus ring opacity"
        )

    if err ~= nil then
        return nil, err
    end

    local inactiveOpacity
    inactiveOpacity, err =
        resolveOpacity(
            variables,
            niri,
            "focus_ring_inactive_opacity",
            "Niri inactive focus ring opacity"
        )

    if err ~= nil then
        return nil, err
    end

    local urgentOpacity
    urgentOpacity, err =
        resolveOpacity(
            variables,
            niri,
            "focus_ring_urgent_opacity",
            "Niri urgent focus ring opacity"
        )

    if err ~= nil then
        return nil, err
    end

    local shadowColor
    shadowColor, err =
        resolver.colorRole(
            niri.shadow_color,
            "Niri shadow color"
        )

    if err ~= nil then
        return nil, err
    end

    local shadowStrength
    shadowStrength, err =
        resolver.default(
            variables,
            "shadow_strength",
            niri.shadow_strength,
            "Niri shadow strength"
        )

    if err ~= nil then
        return nil, err
    end

    shadowStrength, err =
        resolver.number(
            shadowStrength,
            "Niri shadow strength",
            0,
            1
        )

    if err ~= nil then
        return nil, err
    end

    local hasFocusRingColors =
        activeColor ~= nil
        or inactiveColor ~= nil
        or urgentColor ~= nil

    local hasShadowColor = shadowColor ~= nil

    if not hasFocusRingColors and not hasShadowColor then
        return table.concat(lines, "\n"), nil
    end

    table.insert(lines, "layout {")

    if hasFocusRingColors then
        table.insert(lines, "    focus-ring {")

        if activeColor ~= nil then
            table.insert(
                lines,
                "        active-color \""
                    .. resolver.colorExpression(
                        activeColor,
                        activeOpacity
                    )
                    .. "\""
            )
        end

        if inactiveColor ~= nil then
            table.insert(
                lines,
                "        inactive-color \""
                    .. resolver.colorExpression(
                        inactiveColor,
                        inactiveOpacity
                    )
                    .. "\""
            )
        end

        if urgentColor ~= nil then
            table.insert(
                lines,
                "        urgent-color \""
                    .. resolver.colorExpression(
                        urgentColor,
                        urgentOpacity
                    )
                    .. "\""
            )
        end

        table.insert(lines, "    }")
    end

    if hasShadowColor then
        table.insert(lines, "    shadow {")
        table.insert(
            lines,
            "        color \""
                .. resolver.colorExpression(
                    shadowColor,
                    shadowStrength
                )
                .. "\""
        )
        table.insert(lines, "    }")
    end

    table.insert(lines, "}")
    table.insert(lines, "")

    return table.concat(lines, "\n"), nil
end

return generator
