--!nonstrict

local paths = require("../lib/paths.luau")
local parser = require("./parser.luau")
local niriLayout = require("./generators/niri_layout.luau")
local niriWindows = require("./generators/niri_windows.luau")
local niriColors = require("./generators/niri_colors.luau")
local foot = require("./generators/foot.luau")

local pipeline = {}

-- Small enough to stay under Noctalia's per-callback budget while
-- still parsing a typical profile in a few hundred milliseconds.
local PARSE_LINES_PER_TICK = 16

local job = nil

-- Avoid rewriting files that did not change during this service
-- runtime. This reduces unnecessary Niri reloads and template work.
local lastWritten = {}

local function fail(message)
    local result = tostring(message)
    job = nil
    return "error", result
end

local function writeOutput(path, contents)
    if
        lastWritten[path] == contents
        and noctalia.fileExists(path)
    then
        return true, false, nil
    end

    local ok, err =
        noctalia.writeFile(path, contents)

    if not ok then
        return false, false, err
    end

    lastWritten[path] = contents
    return true, true, nil
end

function pipeline.isBusy()
    return job ~= nil
end

function pipeline.start(profileName, contents)
    if job ~= nil then
        return false,
            "A structure profile is already being applied"
    end

    job = {
        profileName = profileName,
        parser = parser.new(contents),
        stage = "parse",
        niriLayout = nil,
        niriWindows = nil,
        niriConfig = nil,
        niriColors = nil,
        foot = nil,
        colorTemplateChanged = false,
        renderFinished = false,
        renderError = nil,
    }

    return true, nil
end

function pipeline.step()
    if job == nil then
        return "idle", nil
    end

    if job.stage == "parse" then
        local done, err =
            parser.step(
                job.parser,
                PARSE_LINES_PER_TICK
            )

        if err ~= nil then
            return fail(
                "Invalid structure profile: " .. err
            )
        end

        if done then
            job.profile = job.parser.result
            job.parser = nil
            job.stage = "niri-layout"
        end

        return "running", nil
    end

    if job.stage == "niri-layout" then
        local generated, err =
            niriLayout.generate(job.profile)

        if generated == nil then
            return fail(
                "Invalid structure profile: "
                .. tostring(err)
            )
        end

        job.niriLayout = generated
        job.stage = "niri-windows"
        return "running", nil
    end

    if job.stage == "niri-windows" then
        local generated, err =
            niriWindows.generate(job.profile)

        if generated == nil then
            return fail(
                "Invalid structure profile: "
                .. tostring(err)
            )
        end

        job.niriWindows = generated
        job.stage = "compose-niri"
        return "running", nil
    end

    if job.stage == "compose-niri" then
        job.niriConfig =
            "// Generated by zap/theme-manager\n"
            .. "// Do not edit manually.\n\n"
            .. job.niriLayout
            .. job.niriWindows

        job.niriLayout = nil
        job.niriWindows = nil
        job.stage = "niri-colors"
        return "running", nil
    end

    if job.stage == "niri-colors" then
        local generated, err =
            niriColors.generate(job.profile)

        if generated == nil then
            return fail(
                "Invalid structure profile: "
                .. tostring(err)
            )
        end

        job.niriColors = generated
        job.stage = "foot"
        return "running", nil
    end

    if job.stage == "foot" then
        local generated, err =
            foot.generate(job.profile)

        if generated == nil then
            return fail(
                "Invalid structure profile: "
                .. tostring(err)
            )
        end

        job.foot = generated
        job.profile = nil
        job.stage = "mkdir"
        return "running", nil
    end

    if job.stage == "mkdir" then
        local ok, err =
            noctalia.mkdirAll(paths.output)

        if not ok then
            return fail(
                "Could not create theme-manager config directory: "
                .. tostring(err)
            )
        end

        job.stage = "write-niri"
        return "running", nil
    end

    if job.stage == "write-niri" then
        local path = paths.output .. "/niri.kdl"
        local ok, _, err =
            writeOutput(path, job.niriConfig)

        if not ok then
            return fail(
                "Could not write Niri structure: "
                .. tostring(err)
            )
        end

        job.niriConfig = nil
        job.stage = "write-colors"
        return "running", nil
    end

    if job.stage == "write-colors" then
        local path =
            paths.output
            .. "/niri-colors.template.kdl"

        local ok, changed, err =
            writeOutput(path, job.niriColors)

        if not ok then
            return fail(
                "Could not write Niri color template: "
                .. tostring(err)
            )
        end

        job.colorTemplateChanged = changed
        job.niriColors = nil
        job.stage = "write-foot"
        return "running", nil
    end

    if job.stage == "write-foot" then
        local path = paths.output .. "/foot.ini"
        local ok, _, err =
            writeOutput(path, job.foot)

        if not ok then
            return fail(
                "Could not write Foot structure: "
                .. tostring(err)
            )
        end

        job.foot = nil

        local renderedColorPath =
            paths.output .. "/niri-colors.kdl"

        if
            job.colorTemplateChanged
            or not noctalia.fileExists(renderedColorPath)
        then
            job.stage = "render-template"
        else
            job.stage = "done"
        end

        return "running", nil
    end

    if job.stage == "render-template" then
        local currentJob = job

        local accepted =
            noctalia.runAsync(
                {
                    "noctalia",
                    "msg",
                    "templates-apply",
                },
                function(result)
                    -- Ignore a late completion from an old/reloaded job.
                    if job ~= currentJob then
                        return
                    end

                    currentJob.renderFinished = true

                    if result.exitCode ~= 0 then
                        currentJob.renderError =
                            tostring(result.stderr)
                    end
                end
            )

        if not accepted then
            return fail(
                "Could not ask Noctalia to render theme templates"
            )
        end

        job.stage = "wait-render"
        return "running", nil
    end

    if job.stage == "wait-render" then
        if not job.renderFinished then
            return "waiting", nil
        end

        if job.renderError ~= nil then
            return fail(
                "Noctalia template rendering failed: "
                .. job.renderError
            )
        end

        job.stage = "done"
        return "running", nil
    end

    if job.stage == "done" then
        local profileName = job.profileName
        job = nil
        return "done", profileName
    end

    return fail(
        "Unknown structure pipeline stage: "
        .. tostring(job.stage)
    )
end

return pipeline
