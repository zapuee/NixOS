--!nonstrict

local resolver = require("../resolver.luau")

local generator = {}

function generator.generate(profile)
    local variables = profile.variables or {}
    local applications = profile.applications or {}
    local terminal = applications.terminal

    local lines = {
        "# Generated by zap/theme-manager",
        "# Do not edit manually.",
        "",
    }

    if
        terminal == nil
        or terminal.enabled == false
        or terminal.target ~= "foot"
    then
        return table.concat(lines, "\n"), nil
    end

    local opacity, err =
        resolver.tier(
            variables,
            terminal.background_opacity,
            "bg_opacity",
            "Terminal background opacity"
        )

    if err ~= nil then
        return nil, err
    end

    opacity, err =
        resolver.number(
            opacity,
            "Terminal background opacity",
            0,
            1
        )

    if err ~= nil then
        return nil, err
    end

    if opacity ~= nil then
        table.insert(lines, "[colors-dark]")
        table.insert(lines, "alpha=" .. tostring(opacity))
        table.insert(lines, "")

        table.insert(lines, "[colors-light]")
        table.insert(lines, "alpha=" .. tostring(opacity))
        table.insert(lines, "")
    end

    return table.concat(lines, "\n"), nil
end

return generator
